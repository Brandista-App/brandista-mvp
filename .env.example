# Copy this file to .env and replace the placeholder credentials and signing key before starting Docker Compose.
MYSQL_DATABASE=brandista
MYSQL_USER=brandista_app
MYSQL_PASSWORD=replace_with_a_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
MYSQL_PORT=3307
BACKEND_PORT=8080
SERVER_PORT=8080
JWT_SECRET_BASE64=replace_with_base64_encoded_random_secret_at_least_32_bytes
JWT_ISSUER=brandista
JWT_AUDIENCE=brandista-api
JWT_ACCESS_TOKEN_TTL=PT15M
CORS_ALLOWED_ORIGINS=
