# Local-only staging rehearsal template. Copy to ignored .env.staging and replace placeholders.
# Never use these local hostnames, ports, or example values for remote staging/production.
MYSQL_DATABASE=brandista_staging_local
MYSQL_USER=brandista_staging_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_ROOT_PASSWORD
MYSQL_PORT=3310
BACKEND_PORT=8082
SERVER_PORT=8080
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_RANDOM_KEY_OF_AT_LEAST_32_BYTES
JWT_ISSUER=brandista-staging-local
JWT_AUDIENCE=brandista-api-staging-local
JWT_ACCESS_TOKEN_TTL=PT15M
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173
