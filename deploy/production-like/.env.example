# Preparation template, not deployment credentials or an invented service URL.
APPROVED_API_HOST=
HTTPS_LOOPBACK_PORT=8443
TLS_CERTIFICATE_FILE=
TLS_PRIVATE_KEY_FILE=
# Use approved private MySQL DNS, database and a trusted server certificate.
# Required URL shape: jdbc:mysql://<approved-db-host>:3306/<database>?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&connectTimeout=3000&socketTimeout=15000
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET_BASE64=
JWT_ISSUER=
JWT_AUDIENCE=
# Exact approved browser origins only. Native Android does not require browser CORS.
CORS_ALLOWED_ORIGINS=
# Enable only after environment-specific stock/checkout/idempotency acceptance.
COD_CHECKOUT_ENABLED=false
